rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdministrator() {
      return request.auth != null &&
        request.auth.token.email == 'abuhafs8007@gmail.com';
    }

    function validClassName(className) {
      return className == 'BASIC 4' || className == 'BASIC 5' ||
        className == 'JSS 1' || className == 'JSS 2' || className == 'JSS 3' ||
        className == 'SS 1' || className == 'SS 2' || className == 'SS 3';
    }

    function validVerifiedStudentLookupRecord(lookup, lookupDocumentId, studentRecord) {
      return lookup.keys().hasAll([
          'lookupId', 'studentId', 'recordStudentId', 'studentRecordId', 'name', 'className'
        ]) &&
        lookup.keys().hasOnly([
          'lookupId', 'studentId', 'recordStudentId', 'studentRecordId', 'name', 'className'
        ]) &&
        lookup.lookupId is string &&
        lookup.lookupId == lookupDocumentId &&
        lookup.lookupId.size() <= 1500 &&
        lookup.studentId is string &&
        lookup.studentId.size() > 0 &&
        lookup.studentId.size() <= 100 &&
        lookup.recordStudentId is string &&
        lookup.recordStudentId.size() > 0 &&
        lookup.recordStudentId.size() <= 100 &&
        lookup.studentRecordId is string &&
        lookup.studentRecordId.size() > 0 &&
        lookup.studentRecordId.size() <= 1500 &&
        lookup.name is string &&
        lookup.name.size() > 0 &&
        lookup.name.size() <= 100 &&
        lookup.className is string &&
        validClassName(lookup.className) &&
        lookup.className.size() <= 100 &&
        (
          (
            'studentId' in studentRecord &&
            studentRecord.studentId == lookup.recordStudentId
          ) ||
          (
            !('studentId' in studentRecord) &&
            lookup.recordStudentId == lookup.studentRecordId
          )
        ) &&
        studentRecord.name == lookup.name &&
        (
          (
            'className' in studentRecord &&
            studentRecord.className is string &&
            studentRecord.className.size() > 0 &&
            studentRecord.className == lookup.className
          ) ||
          (
            (!('className' in studentRecord) ||
              studentRecord.className == null ||
              studentRecord.className == '') &&
            'class' in studentRecord &&
            studentRecord.class == lookup.className
          )
        );
    }

    function validVerifiedStudentIdLookupData(lookup, lookupDocumentId) {
      let studentRecordPath = /databases/$(database)/documents/cbtStudents/$(lookup.studentRecordId);
      return exists(studentRecordPath) &&
        validVerifiedStudentLookupRecord(lookup, lookupDocumentId, get(studentRecordPath).data);
    }

    function validVerifiedStudentIdLookup(lookupDocumentId) {
      return validVerifiedStudentIdLookupData(resource.data, lookupDocumentId);
    }

    function validStudentSubmission(attemptId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'studentId', 'studentLookupId', 'studentName', 'name', 'className', 'class',
          'subjectId', 'subjectName', 'subject', 'status', 'score',
          'percentage', 'totalQuestions', 'answeredCount', 'unansweredCount',
          'timeUsed', 'timestamp', 'dateStarted', 'dateCompleted', 'durationMinutes'
        ]) &&
        data.keys().hasOnly([
            'id', 'studentId', 'studentLookupId', 'studentName', 'name', 'className', 'class',
          'subjectId', 'subjectName', 'subject', 'status', 'score',
          'percentage', 'totalQuestions', 'answeredCount', 'unansweredCount',
          'timeUsed', 'timestamp', 'dateStarted', 'dateCompleted', 'durationMinutes'
        ]) &&
        data.id == attemptId &&
        data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 100 &&
        data.studentLookupId is string && data.studentLookupId.size() > 0 && data.studentLookupId.size() <= 1500 &&
        exists(/databases/$(database)/documents/cbtStudentIdLookup/$(data.studentLookupId)) &&
        validVerifiedStudentIdLookupData(
          get(/databases/$(database)/documents/cbtStudentIdLookup/$(data.studentLookupId)).data,
          data.studentLookupId
        ) &&
        get(/databases/$(database)/documents/cbtStudentIdLookup/$(data.studentLookupId)).data.studentId == data.studentId &&
        get(/databases/$(database)/documents/cbtStudentIdLookup/$(data.studentLookupId)).data.name == data.studentName &&
        data.name == data.studentName &&
        data.studentName is string && data.studentName.size() <= 100 &&
        data.name is string && data.name.size() <= 100 &&
        data.className is string && validClassName(data.className) &&
        get(/databases/$(database)/documents/cbtStudentIdLookup/$(data.studentLookupId)).data.className == data.className &&
        data.class is string && data.class == data.className && validClassName(data.class) &&
        data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 150 &&
        data.subjectName is string && data.subjectName.size() <= 150 &&
        data.subject is string && data.subject.size() <= 150 &&
        data.status == 'Completed' &&
        data.score is int && data.totalQuestions is int &&
        data.totalQuestions >= 1 && data.totalQuestions <= 40 &&
        data.score >= 0 && data.score <= data.totalQuestions &&
        data.percentage is int && data.percentage >= 0 && data.percentage <= 100 &&
        data.answeredCount is int && data.answeredCount >= 0 && data.answeredCount <= data.totalQuestions &&
        data.unansweredCount is int && data.unansweredCount == data.totalQuestions - data.answeredCount &&
        data.timeUsed is string && data.timeUsed.size() <= 10 &&
        data.timestamp is string && data.timestamp.size() <= 40 &&
        data.dateStarted is string && data.dateStarted.size() <= 40 &&
        data.dateCompleted is string && data.dateCompleted.size() <= 40 &&
        data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 300;
    }

    match /cbtStudents/{studentId} {
      allow read, write: if isAdministrator();
    }

    match /cbtStudentIdLookup/{studentId} {
      allow get: if !exists(/databases/$(database)/documents/cbtStudentIdLookup/$(studentId)) ||
        (resource.data.keys().hasOnly(['studentId']) &&
          resource.data.keys().hasAll(['studentId']) &&
          resource.data.studentId is string &&
          resource.data.studentId.size() > 0 &&
          resource.data.studentId.size() <= 100 &&
          resource.data.studentId == studentId) ||
        validVerifiedStudentIdLookup(studentId);
      allow list: if isAdministrator();
      allow create, update: if isAdministrator();
      allow delete: if isAdministrator();
    }

    match /cbtAttempts/{attemptId} {
      allow create: if validStudentSubmission(attemptId);
      allow read, update, delete: if isAdministrator();
    }

    match /cbtSubjects/{subjectId} {
      allow read: if true;
      allow write: if isAdministrator();
    }

    match /cbtQuestions/{questionGroupId} {
      allow read: if true;
      allow write: if isAdministrator();
    }

    match /cbtSettings/{settingId} {
      allow get: if settingId == 'platform' || isAdministrator();
      allow list, write: if isAdministrator();
    }

    match /cbtRemovedSubjects/{subjectId} {
      allow read: if true;
      allow write: if isAdministrator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
